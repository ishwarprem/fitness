            <button class="video-btn" onclick="toggleVideo(this)">WATCH FORM</button>
            <img src="https://www.inspireusafoundation.org/wp-content/uploads/2022/02/inverted-row.gif"
                alt="Australian Rows" class="exercise-video" style="display: none;">
        </div>
        <div class="exercise-item">
            <h4>Ring Rows</h4>
            <p>3 sets of 8-12 reps. Similar to Australian rows but using gymnastic rings for instability.</p>
            <button class="video-btn" onclick="toggleVideo(this)">WATCH FORM</button>
            <img src="https://www.inspireusafoundation.org/wp-content/uploads/2022/10/ring-row.gif" alt="Ring Rows"
                class="exercise-video" style="display: none;">
        </div>
        <div class="exercise-item">
            <h4>Resistance Band Assisted Pull-Ups</h4>
            <p>3 sets of 5-8 reps. Pull-ups with band assistance to build strength progressively.</p>
            <button class="video-btn" onclick="toggleVideo(this)">WATCH FORM</button>
            <img src="https://www.inspireusafoundation.org/wp-content/uploads/2022/02/band-assisted-pull-up.gif"
                alt="Band Assisted Pull-Ups" class="exercise-video" style="display: none;">
        </div>
        <div class="exercise-item">
            <h4>Dead Hangs</h4>
            <p>3 sets of 20-30 seconds. Builds grip strength and prepares shoulders for pull-ups.</p>
            <button class="video-btn" onclick="toggleVideo(this)">WATCH FORM</button>
            <img src="https://www.inspireusafoundation.org/file/2023/06/dead-hang.gif" alt="Dead Hangs"
                class="exercise-video" style="display: none;">
        </div>
        <div class="exercise-item">
            <h4>Scapular Pull-Ups</h4>
            <p>3 sets of 8-10 reps. Focuses on scapular retraction to build pull-up foundation.</p>
            <button class="video-btn" onclick="toggleVideo(this)">WATCH FORM</button>
            <img src="https://www.inspireusafoundation.org/wp-content/uploads/2022/02/scapular-pull-up.gif"
                alt="Scapular Pull-Ups" class="exercise-video" style="display: none;">
        </div>
    </div>
</div>

